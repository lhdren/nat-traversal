# /etc/nat-traversal/ddns.conf — ddns-watch.sh 配置
# 建议使用独立 RAM 子账号的 AccessKey，只授予 AliyunDNSFullAccess 权限。

# 必填：阿里云 AccessKey（仅 DNS 权限的子账号）
ACCESS_KEY_ID=LTAIxxxxxxxxxxxxxxxx
ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：完整主机记录（家宽动态公网 IP 指向它）
SUBDOMAIN=home.example.cn

# 可选
TTL=600                 # 阿里云免费版解析最低 600 秒
CHECK_INTERVAL=30       # 检测间隔（秒）
ENDPOINT=https://alidns.aliyuncs.com

# DRY_RUN=1              # 调试：只打印计划动作，不写解析
